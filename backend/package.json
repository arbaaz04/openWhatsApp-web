{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/__tests__/**\"",
    "test": "vitest run --reporter=verbose",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "vitest": {
    "include": [
      "src/__tests__/**/*.test.ts"
    ],
    "coverage": {
      "include": [
        "src/**/*.ts"
      ],
      "exclude": [
        "src/__tests__/**",
        "src/types/**"
      ],
      "thresholds": {
        "lines": 80,
        "functions": 80,
        "branches": 70,
        "statements": 80
      }
    }
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "latest",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "postgres": "^3.4.9",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "wrangler": "^4.81.1"
  }
}
