{
  "name": "whatflow-web-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-10",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4f1f004b2eace5ca5b30dec4a2b9c90d",
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "SUPABASE_URL": "https://bfctfnsjobtpgolladon.supabase.co",
    "META_APP_ID": "your_app_id",
    "ENVIRONMENT": "local"
  },
  "env": {
    "production": {
      "vars": {
        "ALLOWED_ORIGIN": "https://app.whatflow.io",
        "SUPABASE_URL": "https://bfctfnsjobtpgolladon.supabase.co",
        "META_APP_ID": "your_app_id",
        "ENVIRONMENT": "production"
      },
      "routes": [
        { "pattern": "PROD_BACKEND_HOST", "custom_domain": true }
      ],
      "queues": {
        "producers": [
          {
            "binding": "WEBHOOK_QUEUE",
            "queue": "whatflow-web-webhooks-production"
          },
          {
            "binding": "USER_WEBHOOK_QUEUE",
            "queue": "whatflow-web-user-webhooks-production"
          }
        ],
        "consumers": [
          {
            "queue": "whatflow-web-webhooks-production",
            "max_batch_size": 20,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "dead_letter_queue": "whatflow-web-webhooks-dlq-production"
          },
          {
            "queue": "whatflow-web-user-webhooks-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "whatflow-web-user-webhooks-dlq-production"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "INBOX_SYNC",
            "class_name": "InboxSync"
          }
        ]
      },
      "unsafe": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": {
              "limit": 100,
              "period": 60
            }
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "337639d893dd4ad3a244dff2d93ba894"
        }
      ]
    },
    "development": {
      "vars": {
        "ALLOWED_ORIGIN": "*",
        "SUPABASE_URL": "https://bfctfnsjobtpgolladon.supabase.co",
        "META_APP_ID": "your_app_id",
        "ENVIRONMENT": "development"
      },
      "routes": [
        { "pattern": "DEV_BACKEND_HOST", "custom_domain": true }
      ],
      "queues": {
