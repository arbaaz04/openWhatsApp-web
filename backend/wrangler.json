{
  "name": "whatflow-web-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-10",
  "vars": {
    "META_APP_ID": "",
    "META_APP_SECRET": "",
    "WEBHOOK_VERIFY_TOKEN": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INBOX_SYNC",
        "class_name": "InboxSync"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["InboxSync"]
    }
  ],
  "rate_limiting": [
    {
      "binding": "RATE_LIMITER",
      "namespace_id": "whatflow-rate-limiter",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
