{
  "name": "whatflow-web-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-10",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "4f1f004b2eace5ca5b30dec4a2b9c90d",
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "SUPABASE_URL": "https://bfctfnsjobtpgolladon.supabase.co",
    "ENVIRONMENT": "local"
  },
  "env": {
    "production": {
      "vars": {
        "ALLOWED_ORIGIN": "https://app.whatflow.io",
        "SUPABASE_URL": "https://bfctfnsjobtpgolladon.supabase.co",
        "ENVIRONMENT": "production"
      }
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "whatflow-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "whatflow-webhooks",
        "max_batch_size": 20,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "whatflow-webhooks-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "INBOX_SYNC",
        "class_name": "InboxSync"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["InboxSync"]
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 100,
          "period": 60
        }
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d3ecdcb162f3488f8334ef5afa387f05"
    }
  ]
}
