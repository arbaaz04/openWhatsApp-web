          },
          {
            "queue": "whatflow-web-user-webhooks-development",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "whatflow-web-user-webhooks-dlq-development"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "INBOX_SYNC",
            "class_name": "InboxSync"
          }
        ]
      },
      "unsafe": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": {
              "limit": 100,
              "period": 60
            }
          }
        ]
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "337639d893dd4ad3a244dff2d93ba894"
        }
      ]
    }
  },
  "queues": {
