# Meta App Credentials (shared with backend, but needed at build-time for frontend)
# Get VITE_META_APP_ID from: Meta App Dashboard → Settings → Basic → App ID
# Same value as backend's META_APP_ID
VITE_META_APP_ID=your_meta_app_id_here

# WhatsApp Embedded Signup config_id (frontend-specific)
# Get from: Meta App Dashboard → Settings → Basic → WhatsApp Embedded Signup → config_id
VITE_META_CONFIG_ID=your_meta_config_id_here

# Meta SDK Version
VITE_META_SDK_VERSION=v25.0

# Backend API URL
VITE_API_URL=http://localhost:8787

